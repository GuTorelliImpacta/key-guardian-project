# Copie este arquivo para .env e preencha os valores. Nunca commite o .env com segredos reais.

# --- Formulário de orçamento (P0-B) ---
# Chave de API da Resend (https://resend.com) usada para enviar o e-mail do lead.
RESEND_API_KEY=

# Remetente do e-mail enviado pela Resend. Precisa ser um domínio/endereço verificado na Resend.
LEAD_FROM_EMAIL=

# Destinatário do e-mail de lead. PENDENTE DE CONFIRMAÇÃO DA CLIENTE — sugestão: comercial@keymaster.com.br
LEAD_TO_EMAIL=

# --- SEO técnico (P1-B) ---
# URL absoluta do site, usada em canonical, og:url, og:image e twitter:image.
# Definido também como VITE_SITE_URL para ficar disponível no bundle do cliente (ver README).
VITE_SITE_URL=https://keymasterr.netlify.app

# "true" permite indexação (robots "index, follow" e sitemap sem bloqueio).
# Enquanto o site estiver em *.netlify.app, deixe "false" (ou não defina).
# Na virada para o domínio final, basta trocar para "true" e reimplantar.
VITE_ALLOW_INDEXING=false
